PORT=3000
DATABASE_URL=postgresql://market:market_dev_only@localhost:5432/market_insight
# Run npm run setup to generate a local .env with a random secret, or supply >=32 characters.
AUTH_SECRET=
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081
NODE_ENV=development
# Optional news JSON endpoint. When configured it is collected on startup and periodically.
NEWS_JSON_URL=
COLLECT_INTERVAL_MINUTES=60
# Optional LLM adapter. If absent, local extractive summarization is used.
LLM_API_URL=
LLM_API_KEY=

# Personal stock data provider (Korea Investment Open API). Keep these server-side only.
KIS_APP_KEY=
KIS_APP_SECRET=
# Initial personal watchlist; Korean codes and US tickers.
STOCK_WATCHLIST=005930,000660,AAPL,MSFT
