{
  "expo": {
    "name": "Market Insight",
    "slug": "market-insight",
    "scheme": "marketinsight",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router"
    ],
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.pinchpeach.marketinsight",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EEF2F7"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "usesCleartextTraffic": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
